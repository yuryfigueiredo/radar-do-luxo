[Unit]
Description=Radar do Luxo — Publicação editorial autônoma
Documentation=https://github.com/yuryfigueiredo/radar-do-luxo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/radar-autonomia
ExecStart=/home/ubuntu/radar-autonomia/rodar-ciclo.sh crawler
# 25min e não os 15min do Actions: aqui não há teto de plataforma, e o pior caso
# real (Google morto + 4 degraus externos estourando o próprio timeout) é
# 60s + 115s por matéria × até 6 matérias = 17min. Com 15min o ciclo morreria no
# meio e o passo de publicação nunca rodaria — matéria escrita e perdida.
TimeoutStartSec=25min
Nice=10
