[Unit]
Description=Radar do Luxo — Scout e curadoria global de pautas
Documentation=https://github.com/yuryfigueiredo/radar-do-luxo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
# O runner fica FORA do clone: ele mesmo faz git reset --hard origin/main, e um
# script dentro do repo sumiria no meio da execução enquanto o PR não mergeia.
WorkingDirectory=/home/ubuntu/radar-autonomia
ExecStart=/home/ubuntu/radar-autonomia/rodar-ciclo.sh scout
TimeoutStartSec=15min
# Sem Restart: um ciclo que falhou não deve repetir sozinho — os alarmes reserva
# do crawler já cobrem o buraco, e retry automático duplicaria matéria.
Nice=10
