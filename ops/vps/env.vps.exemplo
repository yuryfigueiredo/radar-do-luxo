# Modelo do ambiente do ciclo na VPS. Instale como /home/ubuntu/radar-do-luxo/.env.vps
# com chmod 600 — o arquivo fica dentro do clone, mas .gitignore já cobre `.env.*`.
# Nada aqui é lido pelo site: são variáveis só do processo node do robô editorial.

# ── Camada Google, sempre a primeira da cadeia (3 hops diretos, 250 req/dia) ──
# Chave de API do Google AI Studio. NÃO é o login do Gemini CLI: o que os termos
# proíbem é acessar "the services powering Gemini CLI" por software de terceiro,
# e essa porta aqui é a API pública — a mesma que o site já usa hoje.
GEMINI_API_KEY=

# ── Supabase: OPCIONAL ──
# Sem estas duas o crawler entra em "Modo Local Primário" e publica só pelo acervo
# em mockData.js — que é o que o site em produção renderiza. Preencha apenas se
# quiser a escrita dupla (acervo + banco).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Degraus de fallback DEPOIS da camada Google: o 9router na própria VPS ──
# Loopback de propósito: o router escuta só em 127.0.0.1:20128 e não existe túnel
# aberto. Um hop externo sem https:// é recusado pelo isSafeBase() do gerador.
# Campos por hop: model, timeoutMs (o padrão de 25s é curto para os modelos de
# raciocínio medidos), maxTokens (omitir deixa o teto do gateway trabalhar) e
# reasoningEffort (o Groq devolve 400 sem ele; "none" é valor inválido).
AI_MODEL_CHAIN='[{"protocol":"openai","model":"groq/openai/gpt-oss-120b","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":25000,"maxTokens":2000,"reasoningEffort":"low"},{"protocol":"openai","model":"cf/@cf/meta/llama-3.1-8b-instruct-fp8-fast","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":30000},{"protocol":"openai","model":"kilo/cohere/north-mini-code:free","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":45000},{"protocol":"openai","model":"mistral/codestral-latest","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":30000},{"protocol":"openai","model":"cf/@cf/mistralai/mistral-small-3.1-24b-instruct","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":30000},{"protocol":"openai","model":"openrouter/dots-studio/dots-3-note-preview:free","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":45000},{"protocol":"openai","model":"cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":45000},{"protocol":"openai","model":"nvidia/minimaxai/minimax-m3.1-flash","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":60000},{"protocol":"openai","model":"cf/@cf/meta/llama-3.2-3b-instruct","base":"http://127.0.0.1:20128/v1","key":"CHAVE_DO_ROUTER","timeoutMs":20000}]'

# ── Botões do ciclo, iguais aos do workflow no Actions ──
MIN_PUBLICATION_INTERVAL_HOURS=0
CAPA_MAX_AGE_HOURS=8
CAPA_MIN_SCORE=80

# O gerador tenta 2 degraus externos por padrão; com 9 escritos no JSON, subir este
# número é o único jeito de os últimos entrarem em jogo. 4 é o que cabe no teto do
# ciclo: Google 60s + (25+30+30+30)s dos quatro primeiros = 175s por matéria no pior
# caso, e um ciclo escreve até 6.
AI_EXTERNO_MAX_HOPS=4

# ── Publicação em main (opcional; sem isto o ciclo roda e não publica) ──
# Deploy key com acesso de ESCRITA, gerada na VPS. O caminho, nunca o conteúdo.
DEPLOY_KEY=/home/ubuntu/.ssh/radar_deploy
