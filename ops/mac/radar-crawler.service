[Unit]
Description=Radar do Luxo — Publicação editorial autônoma (Mac A1278)
Documentation=https://github.com/yuryfigueiredo/radar-do-luxo

[Service]
Type=oneshot
WorkingDirectory=/home/yury/Documentos/Projeto/radar-autonomia
Environment=REPO=/home/yury/Documentos/Projeto/radardoluxo
Environment=LOCK=/home/yury/.cache/radar-editorial.lock
Environment=HASH_NPM=/home/yury/.cache/radar-npm-ci.hash
Environment="RUNNER_SYSTEMCTL=systemctl --user"
ExecStart=/home/yury/Documentos/Projeto/radar-autonomia/rodar-ciclo.sh crawler
# 25min e não os 15min do Actions: aqui não há teto de plataforma, e o pior caso
# real (Google morto + 4 degraus externos estourando o próprio timeout) é
# 60s + 115s por matéria × até 6 matérias = 17min. Com 15min o ciclo morreria no
# meio e o passo de publicação nunca rodaria — matéria escrita e perdida.
TimeoutStartSec=25min
Nice=10

[Install]
WantedBy=default.target
