[Unit]
Description=Radar do Luxo — Scout e curadoria global de pautas (Mac A1278)
Documentation=https://github.com/yuryfigueiredo/radar-do-luxo

[Service]
Type=oneshot
WorkingDirectory=/home/yury/Documentos/Projeto/radar-autonomia
Environment=REPO=/home/yury/Documentos/Projeto/radardoluxo
Environment=LOCK=/home/yury/.cache/radar-editorial.lock
Environment=HASH_NPM=/home/yury/.cache/radar-npm-ci.hash
Environment="RUNNER_SYSTEMCTL=systemctl --user"
ExecStart=/home/yury/Documentos/Projeto/radar-autonomia/rodar-ciclo.sh scout
TimeoutStartSec=15min
# Sem Restart: um ciclo que falhou não deve repetir sozinho — os alarmes reserva
# do crawler já cobrem o buraco, e retry automático duplicaria matéria.
Nice=10

[Install]
WantedBy=default.target
