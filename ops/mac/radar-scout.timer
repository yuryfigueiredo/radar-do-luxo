[Unit]
Description=Agenda do Scout de pautas (09h30 e 18h30 UTC)

[Timer]
# Mesmas janelas do cron 30 9,18 do workflow luxury-curator-scout.yml.
# Persistent=false de propósito: um boot às 14h não deve disparar o scout perdido
# das 09h30. o sufixo UTC pelo mesmo motivo do crawler: o Mac está em -03.
OnCalendar=*-*-* 09:30:00 UTC
OnCalendar=*-*-* 18:30:00 UTC
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
