[Unit]
Description=Agenda da publicação editorial (8 alarmes por dia, UTC)

[Timer]
# Réplica exata das 8 crons do workflow luxury-crawler.yml, na mesma ordem.
# O sufixo UTC em cada alarme é obrigatório: o Mac vive em America/Sao_Paulo (-03) e o texto
# cru dos alarmes seria lido no horário local, 3h antes do turno editorial real.
OnCalendar=*-*-* 01:30:00 UTC
OnCalendar=*-*-* 03:20:00 UTC
OnCalendar=*-*-* 04:50:00 UTC
OnCalendar=*-*-* 11:20:00 UTC
OnCalendar=*-*-* 15:20:00 UTC
OnCalendar=*-*-* 17:10:00 UTC
OnCalendar=*-*-* 18:40:00 UTC
OnCalendar=*-*-* 22:20:00 UTC
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
