# ==========================================
# RADAR DO LUXO — CONFIGURAÇÕES DE AMBIENTE
# ==========================================

# Obtenha estas credenciais no painel do Supabase:
# Acesse: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha Mestre do Painel Administrativo (/admin)
# Padrão: RADAR2026
VITE_ADMIN_PIN=RADAR2026

# Número de WhatsApp Comercial para o Concierge VIP (formato internacional sem + ou -)
# Exemplo: 5511999999999
VITE_CONCIERGE_WHATSAPP=5511999999999

# Google Analytics 4 (Opcional - Gratuito e Ilimitado, ideal para métricas de audiência)
# Exemplo: G-ABC123XYZ
VITE_GA_MEASUREMENT_ID=

# Google AdSense Client ID (Opcional - Ativa os anúncios reais após aprovação)
# Exemplo: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Resend API Key (Gratuito - 3.000 envios/mês em resend.com)
# Dispara e-mail de alerta para você quando alguém se cadastra na newsletter
RESEND_API_KEY=

# E-mail de destino dos alertas da Mesa Editorial
# Padrão: yury@radardoluxo.com.br
ADMIN_NOTIFICATION_EMAIL=yury@radardoluxo.com.br
